# Rails runtime
RAILS_ENV=production
PORT=3000
RAILS_MASTER_KEY=replace-with-your-master-key

# PostgreSQL database connection used by Rails (DATABASE_URL takes precedence over config/database.yml)
DATABASE_URL=postgres://postgres:postgres@db:5432/uber_hits_production
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=uber_hits_production

# External services
MAPBOX_API_KEY=pk.your-mapbox-token
CLOUDINARY_URL=cloudinary://api_key:api_secret@cloud_name
